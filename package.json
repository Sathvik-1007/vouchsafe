{
  "name": "bureau",
  "version": "1.0.0",
  "private": true,
  "description": "A predicate vault for renting. The letting agent gets an answer, not your life. Built on WebMCP cross-origin tool federation.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js && node tests/e2e.mjs",
    "test:unit": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e.mjs",
    "verify:deploy": "node tools/verify-deploy.mjs",
    "serve": "./tools/serve.sh",
    "sync": "./tools/sync-config.sh",
    "docs:tools": "node tools/gen-tools-doc.mjs > TOOLS.md"
  },
  "engines": {
    "node": ">=22"
  }
}
